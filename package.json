{
  "name": "kh3-wellness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "npx concurrently \"npm run dev-frontend\" \"npm run dev-backend\"",
    "dev-frontend": "vite",
    "dev-backend": "cd server && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npx concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "vite build && wrangler pages deploy dist --project-name=olympia-reserveline",
    "deploy": "npm run deploy:worker && npm run deploy:pages",
    "worker:dev": "wrangler dev"
  },
  "build": {
    "appId": "com.beast.fitness",
    "productName": "KH3 WELLNESS",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "server/**/*"
    ],
    "files": [
      "dist/**/*",
      "build/**/*",
      "server/**/*",
      "!server/node_modules/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@whatwg-node/server": "^0.9.71",
    "animejs": "^4.3.6",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "shadcn": "^4.1.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
